PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend-domain.onrender.com

# ==============================================================================
# MONGODB CONNECTION URL
# ==============================================================================
# Paste your MongoDB connection string here (Atlas or Local MongoDB):
# Example Atlas: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/watchparty?retryWrites=true&w=majority
# Example Local: MONGODB_URI=mongodb://127.0.0.1:27017/watchparty
# ==============================================================================
MONGODB_URI=

# ==============================================================================
# REDIS CONNECTION URL (Optional - for multi-instance scaling)
# ==============================================================================
# REDIS_URL=redis://default:password@host:port

# ==============================================================================
# JWT SECRET KEY (For user authentication tokens)
# ==============================================================================
JWT_SECRET=yt-watch-party-secret-key-super-secure-2026
