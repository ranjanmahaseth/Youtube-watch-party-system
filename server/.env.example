# ===========================================================================
# Backend - copy to `.env` for local development.
#
# On Render these are set in the service dashboard. `.env` is git-ignored;
# nothing here is a secret, but keeping config out of Git is still the rule.
# ===========================================================================

# Port the HTTP + Socket.IO server listens on.
# Render injects this automatically; the fallback (5000) is only for local runs.
PORT=5000

# Comma-separated list of frontend origins allowed by CORS.
# Must be the exact origin - scheme + host, no trailing slash.
#   local:      http://localhost:5173
#   production: https://your-frontend.onrender.com
# Multiple origins are fine: https://a.onrender.com,https://b.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# `production` enables startup warnings (e.g. a leftover localhost origin).
# Render sets this for you.
# NODE_ENV=production

# How long an emptied room survives before deletion, in milliseconds.
# Defaults to 5 minutes, which is what lets a solo host refresh the page
# without destroying their own room.
# ROOM_TTL_MS=300000

# Optional Redis connection URL (e.g. rediss://default:pass@host:port)
# Enables the Socket.IO Redis Adapter for horizontal scaling and pub/sub.
# If omitted, the server automatically runs in in-memory mode.
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_UPSTASH_ENDPOINT.upstash.io:6379

