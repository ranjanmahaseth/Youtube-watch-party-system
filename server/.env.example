PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend-domain.onrender.com

# Optional Redis connection string for multi-instance scaling
# REDIS_URL=redis://default:password@host:port

# MongoDB connection string for persistent rooms & users
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/watchparty?retryWrites=true&w=majority

# JWT secret key for user authentication tokens
JWT_SECRET=yt-watch-party-secret-key-super-secure-2026
