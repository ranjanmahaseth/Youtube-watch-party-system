# ===========================================================================
# Frontend - copy to `.env` for local development.
#
# IMPORTANT: Vite reads this at BUILD time and inlines it into the bundle.
# Changing it has no effect until the app is rebuilt, and on Render it must be
# set as a BUILD-time environment variable, not a runtime one.
# ===========================================================================

# Public URL of the backend (REST + Socket.IO share one origin).
#   local:      http://localhost:5000
#   production: https://your-backend.onrender.com
#
# A production build with this missing is rejected by vite.config.js, so a
# deployed bundle can never silently point at localhost.
VITE_SERVER_URL=http://localhost:5000

